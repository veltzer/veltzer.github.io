{
	// This repo's oxlint config: the fleet's shared rules (.oxlintrc.json,
	// byte-identical everywhere, through extends), plus what extends does not
	// carry over: the plugins, the environment this repo's JavaScript runs in,
	// and the globals its pages get from the libraries their <script> tags
	// load, so no-undef knows them and still catches every other undefined name.
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"extends": ["./.oxlintrc.json"],
	"plugins": ["eslint"],
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"globals": {},
	// templates/data_collection.html loads static/data-collection-utils.js before the app and its plugins, all plain <script>s: they use its helpers (the comment names the file)
	"overrides": [
		{
			"files": ["static/data-collection-app.js"],
			"globals": {
				// static/data-collection-utils.js
				"sortKeys": "readonly",
				// static/data-collection-utils.js
				"t": "readonly"
			}
		},
		{
			"files": ["static/plugin-certifications.js"],
			"globals": {
				// static/data-collection-utils.js
				"countBy": "readonly",
				// static/data-collection-utils.js
				"countByYear": "readonly",
				// static/data-collection-utils.js
				"mediaFormatDate": "readonly",
				// static/data-collection-utils.js
				"renderBarChart": "readonly",
				// static/data-collection-utils.js
				"renderStatCard": "readonly",
				// static/data-collection-utils.js
				"t": "readonly"
			}
		},
		{
			"files": ["static/plugin-companies.js"],
			"globals": {
				// static/data-collection-utils.js
				"renderBarChart": "readonly",
				// static/data-collection-utils.js
				"renderStatCard": "readonly",
				// static/data-collection-utils.js
				"t": "readonly",
				// static/data-collection-utils.js
				"tally": "readonly"
			}
		}
	]
}
